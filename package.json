{
  "name": "@local/dsh-my-model",
  "version": "1.4.4",
  "private": true,
  "type": "module",
  "description": "My Model: a DeepSeek web-account model provider for DeepSeek Harness.",
  "scripts": {
    "test": "node test/selftest.mjs && node test/stream-smoke.mjs && node test/host-smoke.mjs && node test/ui-smoke.mjs && node test/rate-limit.mjs && node test/recovery.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "deepseek-web.js",
    "dsml.js",
    "pow.js",
    "sha3_wasm_bg.wasm",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT"
}
